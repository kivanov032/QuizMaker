                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Неверные данные."
                                        },
                                        "errors": {
                                            "properties": {
                                                "id_user": {
                                                    "type": "array",
                                                    "items": {
